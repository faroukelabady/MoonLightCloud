# Safe placeholders only. Copy to .env.local and fill in local values.
# Never commit real secrets.
ENVIRONMENT=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://test:test@localhost:5432/moonlight_dev?sslmode=disable
LOG_LEVEL=info
# Optional: server-side pepper mixed into device-secret verifiers.
# Encoding: base64 StdEncoding, decoding to exactly 32 bytes.
# Development uses a documented fixed value when unset; staging/production
# require an explicit value that is NOT the dev placeholder.
# Generate: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# DEVICE_SECRET_PEPPER=
# Store timezone (IANA) for business-day semantics. Defaults to
# Africa/Cairo in development; required explicitly in staging/production.
# STORE_TIMEZONE=Africa/Cairo
# Temporary report-read Bearer secret (report scope only, until dashboard
# user auth exists). Fail-closed: required 16+ chars in staging/production;
# open reports need ALL of ENVIRONMENT=development,
# ALLOW_UNAUTHENTICATED_REPORTING=true, and no token. Anything else fails
# startup. A missing ENVIRONMENT never grants open reporting.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# REPORTING_API_TOKEN=
# Development-only explicit opt-in for unauthenticated local reporting.
# ALLOW_UNAUTHENTICATED_REPORTING=
# Human authentication (ADR-0053). There is NO default dashboard account in
# any environment: create the first OWNER with
#   go run ./cmd/moonlight-cloud auth bootstrap-owner --login you@example.com --display-name "You"
# (password read from the terminal without echo, or --password-stdin).
# AES-256-GCM key sealing TOTP secrets: 32 random bytes, base64. Required in
# EVERY environment; keep it outside the database and never commit it.
# Local dev scripts generate one into .env.local. Generate: head -c 32 /dev/urandom | base64
# AUTH_MFA_ENCRYPTION_KEY=
# Session bounds (defaults 30m idle / 12h absolute; idle 5m-8h, absolute 1h-168h).
# AUTH_SESSION_IDLE_TIMEOUT=30m
# AUTH_SESSION_ABSOLUTE_TIMEOUT=12h
# DASHBOARD_USERNAME / DASHBOARD_PASSWORD_HASH / DASHBOARD_SESSION_TTL were
# removed; setting any of them now fails startup.
# Built dashboard assets served at /dashboard (repo default dashboard/dist;
# the OCI image bakes its own path — do not set this in production).
# DASHBOARD_ASSETS_DIR=
# Optional: bounded graceful shutdown (e.g. 10s).
# SHUTDOWN_TIMEOUT=10s
# Comma-separated CIDRs whose X-Forwarded-For chain is trusted for login
# rate-limit identity. Empty (default) trusts none: forwarded headers from
# untrusted peers are ignored. Never add ranges you do not operate.
# TRUSTED_PROXY_CIDRS=

# Phase 7C device control plane (default disabled).
# DEVICE_CONTROL_ENABLED=false
# DEVICE_COMMAND_LEASE_DURATION=60s
# DEVICE_ONLINE_WINDOW=60s

# Phase 7D operations engine (default disabled).
# OPERATIONS_ENABLED=false
# OPERATIONS_AUTO_SYNC_ON_RECONNECT=false
# OPERATIONS_SCAN_INTERVAL=60s
# OPERATIONS_SCAN_BATCH_SIZE=100
# OPERATIONS_DEVICE_OFFLINE_AFTER=5m
# OPERATIONS_SYNC_PENDING_STALE_AFTER=30m
# OPERATIONS_SYNC_RUNNING_STALE_AFTER=30m
# OPERATIONS_REPORT_STALE_AFTER=60m
# OPERATIONS_NOTIFICATION_RETRY_STALE_AFTER=60m

-- views
catalog_product_online_state:  WITH RECURSIVE classification(product_id, category_id, depth) AS ( SELECT p_1.product_id, p_1.top_category_id, 0 AS "?column?" FROM catalog_products p_1 UNION SELECT ps.product_id, ps.category_id, 0 FROM catalog_product_subcategories ps UNION SELECT c.product_id, e.parent_id, (c.depth + 1) FROM (classification c JOIN catalog_category_edges e ON ((e.child_id = c.category_id))) ), node AS ( SELECT classification.product_id, classification.category_id, min(classification.depth) AS depth FROM classification GROUP BY classification.product_id, classification.category_id ), eval AS ( SELECT n.product_id, n.category_id, n.depth, (c.category_id IS NULL) AS missing, COALESCE(c.online_enabled, false) AS online_enabled FROM (node n LEFT JOIN catalog_categories c ON ((c.category_id = n.category_id))) ) SELECT product_id, store_id, ((NOT (EXISTS ( SELECT 1 FROM eval e WHERE ((e.product_id = p.product_id) AND e.missing)))) AND (NOT (EXISTS ( SELECT 1 FROM eval e WHERE ((e.product_id = p.product_id) AND (NOT e.online_enabled)))))) AS category_allows_online, CASE WHEN (EXISTS ( SELECT 1 FROM eval e WHERE ((e.product_id = p.product_id) AND e.missing))) THEN 'CATEGORY_STATE_INCOMPLETE'::text WHEN (EXISTS ( SELECT 1 FROM eval e WHERE ((e.product_id = p.product_id) AND (NOT e.online_enabled)))) THEN 'CATEGORY_ONLINE_DISABLED'::text ELSE ''::text END AS block_reason, ( SELECT e.category_id FROM eval e WHERE ((e.product_id = p.product_id) AND (e.missing OR (NOT e.online_enabled))) ORDER BY e.depth, e.category_id LIMIT 1) AS blocking_category_id, ( SELECT string_agg((((((n.category_id)::text || ':'::text) || n.depth) || ':'::text) || CASE WHEN (c.category_id IS NULL) THEN 'x'::text WHEN c.online_enabled THEN '1'::text ELSE '0'::text END), ','::text ORDER BY (n.category_id)::text) AS string_agg FROM (node n LEFT JOIN catalog_categories c ON ((c.category_id = n.category_id))) WHERE (n.product_id = p.product_id)) AS policy_fingerprint, ( SELECT string_agg((((n.category_id)::text || ':'::text) || CASE WHEN (c.category_id IS NULL) THEN 'x'::text ELSE (c.source_revision)::text END), ','::text ORDER BY (n.category_id)::text) AS string_agg FROM (node n LEFT JOIN catalog_categories c ON ((c.category_id = n.category_id))) WHERE (n.product_id = p.product_id)) AS policy_version FROM catalog_products p;
catalog_product_stock:  SELECT p.product_id, p.store_id, CASE WHEN ((count(v.variant_id) > 0) AND (count(i.variant_id) FILTER (WHERE i.ready) = count(v.variant_id))) THEN (sum(i.stock_quantity))::bigint ELSE NULL::bigint END AS stock_quantity FROM ((catalog_products p LEFT JOIN catalog_product_variants v ON (((v.product_id = p.product_id) AND v.is_active AND (NOT v.deleted)))) LEFT JOIN catalog_product_variant_inventory i ON (((i.variant_id = v.variant_id) AND (i.product_id = v.product_id) AND (i.sku = v.sku) AND (v.store_id = p.store_id) AND (i.store_id = p.store_id)))) GROUP BY p.product_id, p.store_id;

-- functions
admin_users_keep_owner: CREATE OR REPLACE FUNCTION public.admin_users_keep_owner() RETURNS trigger LANGUAGE plpgsql AS $function$ BEGIN IF EXISTS (SELECT 1 FROM admin_users) AND NOT EXISTS (SELECT 1 FROM admin_users WHERE role = 'owner' AND status = 'active') THEN RAISE EXCEPTION 'at least one active OWNER must remain' USING ERRCODE = 'check_violation'; END IF; RETURN NULL; END; $function$ 
auth_audit_append_only: CREATE OR REPLACE FUNCTION public.auth_audit_append_only() RETURNS trigger LANGUAGE plpgsql AS $function$ BEGIN RAISE EXCEPTION 'auth audit events are append-only' USING ERRCODE = 'restrict_violation'; END; $function$ 
release_artifacts_immutable: CREATE OR REPLACE FUNCTION public.release_artifacts_immutable() RETURNS trigger LANGUAGE plpgsql AS $function$ BEGIN RAISE EXCEPTION 'release artifacts are immutable' USING ERRCODE = 'check_violation'; END $function$ 
releases_immutable: CREATE OR REPLACE FUNCTION public.releases_immutable() RETURNS trigger LANGUAGE plpgsql AS $function$ BEGIN IF TG_OP = 'DELETE' THEN RAISE EXCEPTION 'releases are never deleted; revoke instead' USING ERRCODE = 'restrict_violation'; END IF; IF NEW.id IS DISTINCT FROM OLD.id OR NEW.manifest_digest IS DISTINCT FROM OLD.manifest_digest OR NEW.release_sequence IS DISTINCT FROM OLD.release_sequence OR NEW.version IS DISTINCT FROM OLD.version OR NEW.build_commit IS DISTINCT FROM OLD.build_commit OR NEW.min_installed_sequence IS DISTINCT FROM OLD.min_installed_sequence OR NEW.key_id IS DISTINCT FROM OLD.key_id OR NEW.envelope IS DISTINCT FROM OLD.envelope OR NEW.imported_by IS DISTINCT FROM OLD.imported_by OR NEW.imported_at IS DISTINCT FROM OLD.imported_at THEN RAISE EXCEPTION 'release identity is immutable' USING ERRCODE = 'check_violation'; END IF; RETURN NEW; END $function$ 

-- triggers
CREATE TRIGGER admin_users_keep_owner AFTER DELETE OR UPDATE ON public.admin_users FOR EACH STATEMENT EXECUTE FUNCTION admin_users_keep_owner()
CREATE TRIGGER auth_audit_append_only BEFORE DELETE OR UPDATE ON public.auth_audit_events FOR EACH ROW EXECUTE FUNCTION auth_audit_append_only()
CREATE TRIGGER release_artifacts_immutable BEFORE DELETE OR UPDATE ON public.release_artifacts FOR EACH ROW EXECUTE FUNCTION release_artifacts_immutable()
CREATE TRIGGER releases_immutable BEFORE DELETE OR UPDATE ON public.releases FOR EACH ROW EXECUTE FUNCTION releases_immutable()


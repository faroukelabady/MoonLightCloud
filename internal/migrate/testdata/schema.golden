CREATE UNIQUE INDEX admin_recovery_codes_pkey ON public.admin_recovery_codes USING btree (id)
CREATE INDEX idx_admin_recovery_codes_user ON public.admin_recovery_codes USING btree (user_id) WHERE (used_at IS NULL)
CREATE UNIQUE INDEX admin_sessions_pkey ON public.admin_sessions USING btree (id)
CREATE UNIQUE INDEX admin_sessions_token_hash_key ON public.admin_sessions USING btree (token_hash)
CREATE INDEX idx_admin_sessions_user ON public.admin_sessions USING btree (user_id) WHERE (revoked_at IS NULL)
CREATE UNIQUE INDEX admin_user_store_memberships_pkey ON public.admin_user_store_memberships USING btree (user_id, store_id)
CREATE INDEX idx_admin_memberships_store ON public.admin_user_store_memberships USING btree (store_id)
CREATE UNIQUE INDEX admin_users_login_key ON public.admin_users USING btree (login)
CREATE UNIQUE INDEX admin_users_pkey ON public.admin_users USING btree (id)
CREATE UNIQUE INDEX auth_audit_events_pkey ON public.auth_audit_events USING btree (id)
CREATE INDEX idx_auth_audit_time ON public.auth_audit_events USING btree (occurred_at DESC, id DESC)

-- constraints
admin_activation_tokens admin_activation_tokens_check CHECK ((expires_at > created_at))
admin_activation_tokens admin_activation_tokens_created_at_not_null NOT NULL created_at
admin_activation_tokens admin_activation_tokens_created_by_fkey FOREIGN KEY (created_by) REFERENCES admin_users(id) ON DELETE RESTRICT
admin_activation_tokens admin_activation_tokens_expires_at_not_null NOT NULL expires_at
admin_activation_tokens admin_activation_tokens_pkey PRIMARY KEY (token_hash)
admin_activation_tokens admin_activation_tokens_token_hash_check CHECK ((octet_length(token_hash) = 32))
admin_activation_tokens admin_activation_tokens_token_hash_not_null NOT NULL token_hash
admin_activation_tokens admin_activation_tokens_user_id_fkey FOREIGN KEY (user_id) REFERENCES admin_users(id) ON DELETE CASCADE
admin_activation_tokens admin_activation_tokens_user_id_not_null NOT NULL user_id
admin_bootstrap_state admin_bootstrap_state_bootstrapped_at_not_null NOT NULL bootstrapped_at
admin_bootstrap_state admin_bootstrap_state_owner_id_fkey FOREIGN KEY (owner_id) REFERENCES admin_users(id) ON DELETE RESTRICT
admin_bootstrap_state admin_bootstrap_state_owner_id_not_null NOT NULL owner_id
admin_bootstrap_state admin_bootstrap_state_pkey PRIMARY KEY (singleton)
admin_bootstrap_state admin_bootstrap_state_singleton_check CHECK (singleton)
admin_bootstrap_state admin_bootstrap_state_singleton_not_null NOT NULL singleton
admin_login_throttle admin_login_throttle_failures_check CHECK ((failures >= 0))
admin_login_throttle admin_login_throttle_failures_not_null NOT NULL failures
admin_login_throttle admin_login_throttle_key_check CHECK (((char_length(key) >= 1) AND (char_length(key) <= 254)))
admin_login_throttle admin_login_throttle_key_kind_check CHECK ((key_kind = ANY (ARRAY['account'::text, 'ip'::text])))
admin_login_throttle admin_login_throttle_key_kind_not_null NOT NULL key_kind
admin_login_throttle admin_login_throttle_key_not_null NOT NULL key
admin_login_throttle admin_login_throttle_lock_count_check CHECK ((lock_count >= 0))
admin_login_throttle admin_login_throttle_lock_count_not_null NOT NULL lock_count
admin_login_throttle admin_login_throttle_pkey PRIMARY KEY (key_kind, key)
admin_login_throttle admin_login_throttle_updated_at_not_null NOT NULL updated_at
admin_login_throttle admin_login_throttle_window_started_at_not_null NOT NULL window_started_at
admin_mfa_credentials admin_mfa_credentials_created_at_not_null NOT NULL created_at
admin_mfa_credentials admin_mfa_credentials_key_version_check CHECK ((key_version >= 1))
admin_mfa_credentials admin_mfa_credentials_key_version_not_null NOT NULL key_version
admin_mfa_credentials admin_mfa_credentials_last_used_step_check CHECK ((last_used_step >= 0))
admin_mfa_credentials admin_mfa_credentials_last_used_step_not_null NOT NULL last_used_step
admin_mfa_credentials admin_mfa_credentials_pkey PRIMARY KEY (user_id)
admin_mfa_credentials admin_mfa_credentials_secret_ciphertext_check CHECK (((octet_length(secret_ciphertext) >= 28) AND (octet_length(secret_ciphertext) <= 256)))
admin_mfa_credentials admin_mfa_credentials_secret_ciphertext_not_null NOT NULL secret_ciphertext
admin_mfa_credentials admin_mfa_credentials_user_id_fkey FOREIGN KEY (user_id) REFERENCES admin_users(id) ON DELETE CASCADE
admin_mfa_credentials admin_mfa_credentials_user_id_not_null NOT NULL user_id
admin_recovery_codes admin_recovery_codes_code_hash_check CHECK ((octet_length(code_hash) = 32))
admin_recovery_codes admin_recovery_codes_code_hash_key UNIQUE (code_hash)
admin_recovery_codes admin_recovery_codes_code_hash_not_null NOT NULL code_hash
admin_recovery_codes admin_recovery_codes_created_at_not_null NOT NULL created_at
admin_recovery_codes admin_recovery_codes_id_not_null NOT NULL id
admin_recovery_codes admin_recovery_codes_pkey PRIMARY KEY (id)
admin_recovery_codes admin_recovery_codes_user_id_fkey FOREIGN KEY (user_id) REFERENCES admin_users(id) ON DELETE CASCADE
admin_recovery_codes admin_recovery_codes_user_id_not_null NOT NULL user_id
admin_sessions admin_sessions_absolute_expires_at_not_null NOT NULL absolute_expires_at
admin_sessions admin_sessions_auth_time_not_null NOT NULL auth_time
admin_sessions admin_sessions_check CHECK ((absolute_expires_at > created_at))
admin_sessions admin_sessions_check1 CHECK (((stage <> 'full'::text) OR (mfa_verified_at IS NOT NULL)))
admin_sessions admin_sessions_created_at_not_null NOT NULL created_at
admin_sessions admin_sessions_csrf_hash_check CHECK ((octet_length(csrf_hash) = 32))
admin_sessions admin_sessions_csrf_hash_not_null NOT NULL csrf_hash
admin_sessions admin_sessions_id_not_null NOT NULL id
admin_sessions admin_sessions_last_seen_at_not_null NOT NULL last_seen_at
admin_sessions admin_sessions_pkey PRIMARY KEY (id)
admin_sessions admin_sessions_revoke_reason_check CHECK (((revoke_reason IS NULL) OR (revoke_reason ~ '^[a-z_]{1,32}$'::text)))
admin_sessions admin_sessions_security_version_not_null NOT NULL security_version
